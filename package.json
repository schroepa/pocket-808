{
  "name": "pocket-808",
  "version": "0.19.0",
  "private": true,
  "type": "module",
  "description": "Pocket 808 – mobile Drum-Machine mit Synth, Sampler, Mixer und FX als einzelne HTML-Datei",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test:unit": "vitest run --project unit --project ui --coverage",
    "prepare": "simple-git-hooks",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:ref": "vitest run --project reference",
    "ref:update": "REF_UPDATE=1 vitest run --project reference",
    "bench": "vitest run --project bench",
    "bench:update": "REF_UPDATE=1 vitest run --project bench",
    "test": "npm run test:unit && npm run test:ref && npm run bench && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "node-web-audio-api": "^2.2.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.4"
  },
  "simple-git-hooks": {
    "pre-commit": "unset REF_UPDATE AXE_UPDATE; npm run lint && npm run typecheck && npm run test:unit && npm run test:ref"
  }
}
